<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="delete-all-marks" author="demo">
        <delete tableName="marks"/>
    </changeSet>

    <changeSet id="insert-default-subjects-for-all-students" author="demo">
        <sql>
            INSERT INTO marks (student_id, subject, score)
            SELECT s.id, subjects.sub, floor(random() * 40 + 60)::int
            FROM students s
            CROSS JOIN (
                SELECT 'English' AS sub 
                UNION ALL SELECT 'Kannada' 
                UNION ALL SELECT 'Hindi'
            ) subjects;
        </sql>
    </changeSet>

</databaseChangeLog>