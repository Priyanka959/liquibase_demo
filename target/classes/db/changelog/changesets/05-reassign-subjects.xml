<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="reassign-3-subjects-to-all" author="demo">
        <!-- Step 1: Delete all current marks for all students -->
        <delete tableName="marks"/>

        <!-- Step 2: Assign English, Kannada, and Hindi to every student currently in hte table -->
        <sql>
            INSERT INTO marks (student_id, subject, score)
            SELECT s.id, subjects.sub, floor(random() * 40 + 60)::int
            FROM students s
            CROSS JOIN (
                SELECT 'English' AS sub 
                UNION ALL SELECT 'Kannada' 
                UNION ALL SELECT 'Hindi'
            ) subjects;
        </sql>
    </changeSet>

</databaseChangeLog>